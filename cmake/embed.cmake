# cmake -DIN=<file> -DOUT=<header> -P embed.cmake : binary file -> C byte array (data contains NUL bytes)
file(READ "${IN}" hex HEX)
string(LENGTH "${hex}" len)
math(EXPR n "${len} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," arr "${hex}")
file(WRITE "${OUT}" "// generated by cmake/embed.cmake from ${IN}\n#include <cstddef>\nstatic const unsigned char trace_optixir[] = {${arr}};\nstatic const size_t trace_optixir_len = ${n};\n")
